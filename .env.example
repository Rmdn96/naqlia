# Application
# Local development value. Vercel Production and Preview use https://naqlk.vercel.app.
# The planned commercial origin https://naqlk.com is not active until the documented cutover.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Sales workspace fallback until Business Settings Management is implemented.
# Express as a decimal (for example, 0.15 for 15%). Do not expose this through NEXT_PUBLIC_.
NAQLK_DEFAULT_QUOTATION_VAT_RATE=0.15
NAQLK_DEFAULT_QUOTATION_VALIDITY_DAYS=7

# Supabase - public connection values from the project Connect dialog
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Authentication provider availability - enable only after dashboard setup
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Supabase - optional server-only key for storage reconciliation and staff provisioning
# Never expose this value with a NEXT_PUBLIC_ prefix or use it in application clients.
SUPABASE_SECRET_KEY=

# Operator/CI only: direct PostgreSQL connection used by the read-only migration-drift check.
# Store this in an approved secret manager; never expose it to the browser or Vercel application runtime.
SUPABASE_DB_URL=
