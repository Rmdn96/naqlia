# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en

# Supabase - safe for browser use when Row Level Security is configured
NEXT_PUBLIC_SUPABASE_URL=
