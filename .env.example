# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase - public connection values from the project Connect dialog
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Authentication provider availability - enable only after dashboard setup
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Supabase - optional server-only key for storage reconciliation and staff provisioning
# Never expose this value with a NEXT_PUBLIC_ prefix or use it in application clients.
SUPABASE_SECRET_KEY=
