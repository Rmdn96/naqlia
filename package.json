{
  "name": "naqlia",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise logistics SaaS platform foundation for Saudi Arabia.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high",
    "supabase:staff:provision": "node --env-file-if-exists=.env.local scripts/supabase/provision-staff.mjs",
    "supabase:storage:check": "node --env-file-if-exists=.env.local scripts/supabase/initialize-storage.mjs --check",
    "supabase:storage:init": "node --env-file-if-exists=.env.local scripts/supabase/initialize-storage.mjs --apply",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run security:audit",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.22",
    "next-intl": "4.13.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "17.3.0",
    "postcss": "8.5.25",
    "prettier": "3.9.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
